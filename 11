def factorial(n):
    result = 1
    for i in range(1, n + 1):
        result = result * i
    return result
 
 
n = int(input())
f = factorial(n)
 
result_list = []
for i in range(f, 0, -1):
    result_list.append(factorial(i))
 
print(result_list)
 
