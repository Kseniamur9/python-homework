pets = {}

pet_name = input("Введите имя питомца: ")
pet_type = input("Введите вид питомца: ")
pet_age = int(input("Введите возраст питомца: "))
owner_name = input("Введите имя владельца: ")

pets[pet_name] = {
    'Вид питомца': pet_type,
    'Возраст питомца': pet_age,
    'Имя владельца': owner_name
}

age = pet_age
if 11 <= age % 100 <= 19:
    age_word = "лет"
else:
    rem = age % 10
    if rem == 1:
        age_word = "год"
    elif 2 <= rem <= 4:
        age_word = "года"
    else:
        age_word = "лет"

for key in pets.keys():
    value = pets[key]
    print(f'Это {value["Вид питомца"]} по кличке "{key}". Возраст питомца: {value["Возраст питомца"]} {age_word}. Имя владельца: {value["Имя владельца"]}')




