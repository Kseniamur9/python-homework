word = input()

vowels = "aeiou"
vowel_counts = {v: 0 for v in vowels}

total_vowels = 0
total_consonants = 0

for ch in word:
    if ch in vowels:
        vowel_counts[ch] += 1
        total_vowels += 1
    else:
        total_consonants += 1

print(total_vowels)
print(total_consonants)

for v in vowels:
    if vowel_counts[v] > 0:
        print(v, vowel_counts[v])
    else:
        print(v, False)


