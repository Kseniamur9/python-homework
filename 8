m = int(input())
n = int(input())
weights = []
for i in range(n):
    weights.append(int(input()))

weights.sort()

boats = 0
left = 0
right = n - 1

while left <= right:
    if weights[left] + weights[right] <= m:
        left += 1
        right -= 1
    else:
        right -= 1
    boats += 1

print(boats)
