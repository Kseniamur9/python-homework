class Kassa(object):
    balance = 0

    def __init__(self, b):
        self.balance = b

    def top_up(self, x):
        self.balance += x

    def count_1000(self):
        return self.balance // 1000

    def take_away(self, x):
        if x > self.balance:
            raise Exception('Недостаточно денег в кассе')
        self.balance -= x


kassa = Kassa(0)
print(kassa.balance)
kassa.top_up(5500)
print(kassa.balance)
print(kassa.count_1000())

print()

kassa.take_away(1500)
print(kassa.balance)


