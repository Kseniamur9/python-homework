class Cherepashka(object):
    x = 0
    y = 0
    s = 1

    def __init__(self, x, y, s):
        self.x = x
        self.y = y
        self.s = s

    def go_up(self):
        self.y += self.s

    def go_down(self):
        self.y -= self.s

    def go_left(self):
        self.x -= self.s

    def go_right(self):
        self.x += self.s

    def evolve(self):
        self.s += 1

    def degrade(self):
        if self.s - 1 <= 0:
            raise Exception('Шаг s не может быть <= 0')
        self.s -= 1

    def count_moves(self, x2, y2):
        dx = abs(x2 - self.x)
        dy = abs(y2 - self.y)
        return dx // self.s + dy // self.s


turtle = Cherepashka(0, 0, 2)
print(turtle.x, turtle.y)
turtle.go_right()
turtle.go_up()
print(turtle.x, turtle.y)

print()

turtle.evolve()
print(turtle.s)
print(turtle.count_moves(8, 8))
